<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>ogs_telemetry</AssemblyName>
    <RootNamespace>Ogs.BepInEx</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../OgsTelemetry/*.cs" Link="OgsTelemetry/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- real BepInEx.dll, fetched by prepare-refs.ps1 (LGPL, redistributable) -->
    <Reference Include="BepInEx">
      <HintPath>../lib/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- our compile-only stub; runtime binds to the game's real module.
         AssemblyName is "UnityEngine.CoreModule" but BepInEx.dll was built
         against the classic type-forwarding "UnityEngine" facade, so the
         stub must be named "UnityEngine" for its MonoBehaviour to unify. -->
    <Reference Include="UnityEngine">
      <HintPath>../vendor/UnityEngineStub/bin/Debug/netstandard2.0/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- spans on .NET Framework for the vendored core -->
    <PackageReference Include="System.Memory" Version="4.5.5" />
  </ItemGroup>

</Project>
